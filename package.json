{
	"name": "plsqldoc",
	"version": "1.2.0",
	"private": false,
	"description": "Static documentation generator for Oracle PL/SQL APIs",
	"keywords": [
		"antlr",
		"cli",
		"documentation",
		"oracle",
		"pldoc",
		"plsql",
		"typedoc"
	],
	"homepage": "https://github.com/doberkofler/plsqldoc#readme",
	"bugs": {
		"url": "https://github.com/doberkofler/plsqldoc/issues"
	},
	"license": "MIT",
	"author": "Dieter Oberkofler",
	"repository": {
		"type": "git",
		"url": "https://github.com/doberkofler/plsqldoc.git"
	},
	"bin": "./dist/index.js",
	"type": "module",
	"scripts": {
		"grammar:download": "node scripts/downloadGrammar.ts",
		"grammar:generate": "antlr-ng -Dlanguage=TypeScript -o src/generated PlSqlLexer.g4",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test && pnpm run test:integration",
		"test": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"release": "release-it",
		"create-changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
		"prepare": "husky",
		"dev": "vite build --watch",
		"build": "vite build",
		"integration-test": "node dist/index.js ./examples -o ./docs --verbose --extensions .sql,.pks,.pkb,.tps"
	},
	"dependencies": {
		"antlr4ng": "3.0.16",
		"cli-progress": "3.12.0",
		"commander": "15.0.0",
		"debug": "4.4.3",
		"glob": "13.0.6",
		"handlebars": "4.7.9",
		"markdown-it": "15.0.2",
		"sanitize-html": "2.18.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@types/cli-progress": "3.11.6",
		"@types/debug": "4.1.13",
		"@types/markdown-it": "14.2.0",
		"@types/node": "26.6.3",
		"@types/sanitize-html": "2.16.2",
		"@vitest/coverage-v8": "5.0.3",
		"antlr-ng": "1.0.10",
		"conventional-changelog": "8.1.3",
		"conventional-changelog-angular": "9.4.0",
		"eslint-plugin-regexp": "3.3.1",
		"husky": "9.1.7",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"release-it": "21.1.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	},
	"create-template-project": {
		"template": "cli"
	}
}
